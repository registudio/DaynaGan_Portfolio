# Contact form (Comms Core). Get a key at https://resend.com — server only.
RESEND_API_KEY=
# Where messages are delivered. Defaults to the email in content/portfolio.md.
CONTACT_TO_EMAIL=daynagsr@gmail.com
# Verified Resend sender, e.g. "Dayna's Portfolio <hello@yourdomain.com>".
# Without a verified domain, Resend's test sender only delivers to the account owner.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Optional: GitHub token (read-only) for the full contribution calendar.
GITHUB_TOKEN=
# Canonical site URL for metadata, e.g. https://daynagan.vercel.app
NEXT_PUBLIC_SITE_URL=
